  endingType: 2
  lines:
  - "\u4f60\u4e3e\u8d77\u8b66\u5fbd\uff1a\u201c\u73b0\u5728\u4f60\u88ab\u6355\u4e86\u3002\u201d"
  - "\u98ce\u8863\u7537\u6ca1\u6709\u53cd\u6297\u3002\u4f60\u628a\u4ed6\u94d0\u5728\u6696\u6c14\u7247\u4e0a\uff0c\u62e8\u901a\u8b66\u5c40\u7535\u8bdd\u3002"
  - "\u201cNC-2077\uff0c\u8bf7\u6c42\u652f\u63f4\u3002\u5acc\u7591\u4eba\u5df2\u63a7\u5236\u3002\u201d"
  - "\u7535\u8bdd\u90a3\u5934\u6c89\u9ed8\u5f88\u4e45\uff1a\u201c\u2026\u2026\u4f60\u771f\u7684\u786e\u5b9a\u5417\uff1f\u4ed6\u53ef\u662f\u4f60\u7684\u4eba\u3002\u201d"
  - "\u201c\u4ee5\u524d\u662f\u3002\u201d"
  - "\u98ce\u8863\u7537\u56de\u5934\u770b\u4f60\uff1a\u201c\u4f60\u7ec8\u4e8e\u505a\u5bf9\u4e86\u4e00\u6b21\u3002\u201d"
  finalImageText: "\u8b66\u8f66\u9a76\u5165\u6668\u5149\uff0c\u4f60\u7ad9\u5728\u96e8\u4e2d\uff0c\u624b\u91cc\u6525\u7740\u67d3\u8840\u7eb8\u6761\u3002"
