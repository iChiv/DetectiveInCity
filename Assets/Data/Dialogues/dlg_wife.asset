    forbiddenFlags: []
    requireVoiceLevel:
      voice: 0
      minLevel: 0
    requireClueCountMin: -1
    requireClueCountMax: -1
    startFinalDuel: 0
    resultLines:
    - "\u201C\u662F\u4E00\u4E2A\u7A7F\u98CE\u8863\u7684\u7537\u4EBA\u3002\u4ED6\u4EEC\u5435\u5F97\u5F88\u51F6\u3002\u7136\u540E\u4ED6\u5C31\u2026\u2026\u201D\u83B7\u5F97\u7EBF\u7D22\u3010\u98CE\u8863\u7537\u6700\u540E\u89C1\u9762\u3011\u3002\u903B\u8F91+1\u3002"
    isTerminal: 1
  - text: "\u201C\u4F60\u4E08\u592B\u5230\u5E95\u5728\u67E5\u4EC0\u4E48\uFF1F\u201D"
    voiceTag: 0
    grantedClueIds:
