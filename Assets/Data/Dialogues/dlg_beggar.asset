  openingLines:
  - "\u201C\u597D\u5FC3\u4EBA\uFF0C\u7ED9\u6211\u70B9\u94B1\u5427\u2026\u2026\u6211\u770B\u4F60\u662F\u8B66\u5BDF\u5427\u3002\u6628\u665A\u6211\u770B\u5230\u597D\u591A\u4E8B\u5462\uFF0C\u4F46\u6211\u73B0\u5728\u592A\u51B7\u4E86\uFF0C\u8BB0\u4E0D\u6E05\u2026\u2026\u54CE\u5466\u6211\u7684\u5934\u3002\u201D"
