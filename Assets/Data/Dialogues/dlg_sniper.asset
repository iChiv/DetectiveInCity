  openingLines:
  - "\u201C\u4F60\u5148\u522B\u8FC7\u6765\uFF0C\u51B7\u9759\u70B9\u3002\u6211\u4E0D\u662F\u6765\u6740\u4F60\u7684\u3002\u6211\u53EA\u662F\u6765\u8B66\u544A\u4F60\u7684\u3002\u201D"
  voicePopups:
  - voice: 4
    text: "\u4F46\u4ED6\u5728\u7784\u51C6\u4F60\u3002\u4ED6\u968F\u65F6\u4F1A\u5F00\u67AA\u3002"
  - voice: 1
    text: "\u4ED6\u8BF4\u4E0D\u662F\u6765\u6740\u4F60\u7684\u2014\u2014\u4F46\u4E8B\u5B9E\u5C31\u662F\uFF0C\u4ED6\u6709\u67AA\u3002"
  options:
  - text: "\u201C\u8C01\u6D3E\u4F60\u6765\u7684\uFF1F\u201D"
    voiceTag: 0
