    requireClueCountMax: -1
    startFinalDuel: 0
    resultLines:
    - "\u201C\u5475\u5475\uFF0C\u4F60\u662F NC-2077\uFF0C\u4E09\u5E74\u524D\u5367\u5E95\u5931\u8D25\u3001\u88AB\u5F00\u9664\u7684\u8B66\u5458\u3002\u4F46\u4F60\u8FD8\u5728\u67E5\u6848\u3002\u201D\u83B7\u5F97\u7EBF\u7D22\u3010\u4F60\u7684\u8FC7\u53BB\u3011\u3002"
    isTerminal: 1
  - text: "\u201C\u522B\u5E9F\u8BDD\u4E86\uFF0C\u76F4\u63A5\u5F00\u67AA\u5427\u3002\u201D"
