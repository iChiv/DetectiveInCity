    requireClueCountMax: -1
    startFinalDuel: 0
    resultLines:
    - "\u201C\u662F\u4F60\u4EE5\u524D\u7684\u4E0A\u7EA7\u3002\u4ED6\u8BF4\u4F60\u67E5\u592A\u6DF1\u4E86\u3002\u201D\u83B7\u5F97\u7EBF\u7D22\u3010\u8B66\u5C40\u9AD8\u5C42\u4ECB\u5165\u3011\u3002\u6743\u5A01+1\uFF08\u4F60\u6B63\u9762\u9876\u4F4F\u4E86\u67AA\u53E3\uFF09\u3002"
    isTerminal: 1
  - text: "\u201C\u5475\u5475\uFF0C\u4F60\u77E5\u9053\u6211\u662F\u8C01\u5417\uFF1F\u201D"
    voiceTag: 0
