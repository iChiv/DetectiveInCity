      voice: 0
      minLevel: 0
    requireClueCountMin: -1
    requireClueCountMax: -1
    startFinalDuel: 0
    resultLines:
    - "\u9152\u4FDD\u914D\u5408\uFF1A\u201C\u4F60\u8BF4\u90A3\u4E2A\u5947\u602A\u7684\u7537\u7684\uFF1F\u4ED6\u548C\u4E00\u4E2A\u7A7F\u98CE\u8863\u7684\u7537\u4EBA\u6765\u8FC7\uFF0C\u4E24\u4EBA\u5435\u5F97\u5F88\u51F6\uFF0C\u98CE\u8863\u7537\u8FD8\u7528\u9152\u74F6\u91CD\u91CD\u62CD\u4E86\u684C\u5B50\u3002\u201D\u83B7\u5F97\u7EBF\u7D22\u3010\u98CE\u8863\u7537\u3011\u3002\u6743\u5A01+1\u3002"
    isTerminal: 1
  - text: "\u201C\u8FD9\u6B21\u559D\u70B9\u4E0D\u4E00\u6837\u7684\u5427\u3002\u201D\uFF08\u65E0\u9152\u7CBE\uFF09"
