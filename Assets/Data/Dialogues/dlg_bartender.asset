  characterDefinition: {fileID: 11400000, guid: 277d1454015820d43bff742683d5f344, type: 2}
  openingLines:
  - "\u201C\u8B66\u5B98\uFF0C\u597D\u4E45\u4E0D\u89C1\u4E86\u554A\u54C8\u54C8\u54C8\u54C8\u3002\u8FD8\u662F\u8001\u6837\u5B50\uFF1F\u201D"
  voicePopups:
  - voice: 1
    text: "\u4ED6\u4E00\u770B\u5C31\u8BA4\u8BC6\u4F60\u3002\u8BA9\u4ED6\u522B\u88C5\u50BB\uFF0C\u5957\u51FA\u6628\u665A\u7684\u65F6\u95F4\u7EBF\u3002"
  - voice: 3
    text: "\u867D\u7136\u662F\u719F\u4EBA\uFF0C\u4F46\u8981\u8BA9\u4ED6\u914D\u5408\uFF0C\u76F4\u63A5\u4EAE\u8B66\u5FBD\u6700\u5FEB\u3002"
  options:
  - text: "\u201C\u662F\u5417\uFF0C\u90A3\u6628\u665A\u6211\u51E0\u70B9\u6765\u7684\uFF1F\u201D"
    voiceTag: 1
