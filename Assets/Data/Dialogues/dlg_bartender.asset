    requireClueCountMax: -1
    startFinalDuel: 0
    resultLines:
    - "\u201C23:30 \u5DE6\u53F3\u3002\u4F60\u559D\u4E86\u4E00\u676F\uFF0C\u63A5\u4E86\u4E2A\u7535\u8BDD\u5C31\u8D70\u4E86\uFF0C\u8138\u8272\u5F88\u96BE\u770B\u3002\u201D\u83B7\u5F97\u7EBF\u7D22\u3010\u9152\u5427\u65F6\u95F4\u7EBF\u3011\u3002\u903B\u8F91+1\u3002"
    isTerminal: 1
  - text: "\u201C\u8B66\u5BDF\u529E\u6848\u3002\u6628\u665A\u6B7B\u8005\u6765\u8FC7\u5417\uFF1F\u201D"
    voiceTag: 3
