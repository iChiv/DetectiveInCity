      minLevel: 0
    requireClueCountMin: -1
    requireClueCountMax: -1
    startFinalDuel: 0
    resultLines:
    - "\u4FDD\u5B89\u5D29\u6E83\uFF1A\u201C\u6709\u4EBA\u7ED9\u4E86\u6211\u94B1\u2026\u2026\u8BA9\u6211\u5220\u6389
      23:00\u201323:30 \u7684\u5F55\u50CF\u3002\u201D\u83B7\u5F97\u7EBF\u7D22\u3010\u4FDD\u5B89\u88AB\u6536\u4E70\u3011\u4E0E\u3010\u88AB\u5220\u5F55\u50CF\uFF1A23:00\u201323:30\u3011\u3002\u903B\u8F91+1\u3002"
    isTerminal: 1
  - text: "\u201C\u522B\u5728\u6211\u9762\u524D\u6492\u8C0E\u3002\u6211\u518D\u95EE\u6700\u540E\u4E00\u6B21\uFF0C\u6628\u665A\u5230\u5E95\u8C01\u6765\u4E86\uFF1F\u201D"
    voiceTag: 3
    grantedClueIds:
    - clue_guard_bribed
    - clue_trenchcoat_came
    voiceChanges:
    - voice: 3
      delta: 1
    timeAdvanceMinutes: 0
    timeAdvanceToMinutes: -1
