      voice: 0
      minLevel: 0
    requireClueCountMin: -1
    requireClueCountMax: -1
    startFinalDuel: 0
    resultLines:
    - "\u4FDD\u5B89\u614C\u5F20\u5730\u8BF4\uFF1A\u201C\u662F\u4E00\u4E2A\u7A7F\u98CE\u8863\u7684\u7537\u4EBA\uFF01\u4ED6\u7ED9\u4E86\u6211\u4E00\u4E07\u5757\uFF01\u4ED6\u8BF4\u60F3\u529E\u6CD5\u963B\u6320\u90A3\u4E2A\u8B66\u63A2\u7EE7\u7EED\u67E5\u4E0B\u53BB\uFF01\u201D\u83B7\u5F97\u7EBF\u7D22\u3010\u4FDD\u5B89\u88AB\u6536\u4E70\u3011\u4E0E\u3010\u98CE\u8863\u7537\u6765\u8FC7\u3011\u3002\u6743\u5A01+1\u3002"
    isTerminal: 1
  - text: "\u201C\u548C\u6211\u8BF4\u8BF4\u5427\uFF0C\u4F60\u5728\u5BB3\u6015\u4EC0\u4E48\uFF1F\u201D"
