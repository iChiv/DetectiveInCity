  characterDefinition: {fileID: 11400000, guid: 26d349e88a39b3346a85b0ed3a10abfa, type: 2}
  openingLines:
  - "\u201C\u8B66\u5B98\uFF0C\u6211\u771F\u7684\u4EC0\u4E48\u90FD\u4E0D\u77E5\u9053\u3002\u6211\u6628\u665A\u867D\u7136\u5728\u503C\u73ED\uFF0C\u4F46\u4EC0\u4E48\u90FD\u6CA1\u770B\u5230\u3002\u6211\u53D1\u8A93\uFF0C\u6211\u5B8C\u5168\u6CA1\u6709\u8D70\u795E\u3002\u201D"
  voicePopups:
  - voice: 1
    text: "\u4ED6\u773C\u795E\u98D8\u5FFD\uFF0C\u624B\u5728\u6296\u3002\u4ED6\u5728\u6492\u8C0E\u3002"
  - voice: 3
    text: "\u76F4\u63A5\u7528\u8B66\u5FBD\u538B\u4ED6\u3002\u4ED6\u6CA1\u80C6\u5B50\u5728\u8FD9\u79CD\u60C5\u51B5\u4E0B\u6492\u8C0E\u3002"
  options:
  - text: "\u201C\u90A3\u6211\u95EE\u4F60\uFF0C\u76D1\u63A7\u4E3A\u4EC0\u4E48\u88AB\u5220\u4E86\uFF1F\u201D"
    voiceTag: 1
    grantedClueIds:
    - clue_guard_bribed
    - clue_deleted_footage
    voiceChanges:
    - voice: 1
      delta: 1
    timeAdvanceMinutes: 0
    timeAdvanceToMinutes: -1
    focusDelta: 0
