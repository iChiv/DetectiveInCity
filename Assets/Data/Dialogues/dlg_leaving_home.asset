  openingLines:
  - "\u4F60\u7AD9\u5728\u81EA\u5BB6\u95E8\u53E3\uFF0C\u624B\u63E1\u7740\u95E8\u628A\u624B\u3002\u96E8\u58F0\u9694\u7740\u95E8\u677F\u6E17\u8FDB\u6765\u3002\u63A5\u4E0B\u6765\u53BB\u54EA\uFF1F"
