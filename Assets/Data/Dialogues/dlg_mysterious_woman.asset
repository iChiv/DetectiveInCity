  characterDefinition: {fileID: 11400000, guid: b288e616de21bf6429382fba86dc60e2, type: 2}
  openingLines:
  - "\u4F60\u679C\u7136\u8FD8\u6D3B\u7740\uFF0C\u5475\u5475\u3002\u770B\u6765\u4F60\u8FD0\u6C14\u8FD8\u662F\u4E00\u5982\u65E2\u5F80\u7684\u597D\u5462\u3002"
  voicePopups:
  - voice: 1
    text: "\u5979\u7528\u4E86\u201C\u679C\u7136\u201D\u2014\u2014\u5979\u77E5\u9053\u4F60\u4F1A\u6765\u3002\u5148\u95EE\u6E05\u5177\u4F53\u60C5\u51B5\u3002"
  - voice: 2
    text: "\u5979\u7684\u58F0\u97F3\u5728\u6296\uFF0C\u60C5\u7EEA\u4E0D\u592A\u7A33\u5B9A\u3002\u5148\u5B89\u629A\u5979\u5427\u3002"
  options:
  - text: "\u201C\u4F60\u786E\u5B9A\u6211\u6628\u665A\u771F\u7684\u6765\u8FC7\uFF1F\u51E0\u70B9\u5462\uFF1F\u201D"
