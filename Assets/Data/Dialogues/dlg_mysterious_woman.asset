    requireClueCountMax: -1
    startFinalDuel: 0
    resultLines:
    - "\u201C\u4F60\u5F53\u65F6\u4E0D\u5728\u9152\u5427\u2014\u201423:10 \u5DE6\u53F3\uFF0C\u6211\u770B\u89C1\u4E00\u4E2A\u7A7F\u98CE\u8863\u7684\u7537\u4EBA\u548C\u53E6\u4E00\u4E2A\u4EBA\u5728\u8857\u53E3\u5435\u5F97\u53EF\u51F6\u4E86\u3002\u5176\u4E2D\u4E00\u4E2A\u2026\u2026\u662F\u4F60\u3002\u201D\u83B7\u5F97\u7EBF\u7D22\u3010\u795E\u79D8\u5973\u5B50\u8BC1\u8BCD\u3011\u3002\u903B\u8F91+1\u3002"
    isTerminal: 1
  - text: "\u201C\u4E0D\u597D\u610F\u601D\u5973\u58EB\uFF0C\u6211\u662F\u4E0D\u662F\u5413\u5230\u4F60\u4E86\uFF1F\u201D"
