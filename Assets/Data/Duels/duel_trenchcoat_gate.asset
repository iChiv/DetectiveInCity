  duelId: trenchcoat_gate
  title: "\u8A00\u8BED\u5BF9\u51B3\uFF1A\u5BA1\u95EE\u98CE\u8863\u7537"
  opponentName: "\u98CE\u8863\u7537"
  openingLines:
  - "\u5509\uFF0C\u6211\u548C\u4F60\u8BF4\u8FC7\uFF0C\u4F60\u4E0D\u8BE5\u67E5\u4E0B\u53BB\u7684\u3002\u4F60\u867D\u7136\u5FD8\u4E86\uFF0C\u4F46\u6211\u8BB0\u5F97\u3002"
  voicePopups:
  - voice: 1
    text: "\u4ED6\u8BF4\u76D1\u63A7\u80FD\u8BC1\u660E\u2014\u2014\u53EF\u76D1\u63A7\u88AB\u5220\u4E86\u3002\u4ED6\u5728\u865A\u5F20\u58F0\u52BF\u3002"
  - voice: 3
    text: "\u4F60\u662F\u8B66\u5BDF\uFF0C\u4E0D\u7528\u6015\uFF0C\u76F4\u63A5\u538B\u4ED6\u3002"
  - voice: 2
    text: "\u4ED6\u8BF4\u201C\u4F60\u5FD8\u4E86\u201D\u7684\u65F6\u5019\uFF0C\u8BED\u6C14\u5F88\u590D\u6742\u3002\u4ED6\u4E0D\u5168\u662F\u6076\u610F\u3002"
  - voice: 4
    text: "\u4ED6\u8BF4\u7684\u5BF9\u3002\u4F60\u5FD8\u4E86\u3002\u4F60\u5230\u5E95\u5FD8\u4E86\u4EC0\u4E48\uFF1F"
  statements:
  - text: "\u6211\u6628\u665A\u6839\u672C\u6CA1\u6765\u8FC7\u8FD9\u91CC\u3002\u76D1\u63A7\u5B8C\u5168\u53EF\u4EE5\u8BC1\u660E\u3002"
    phaseLabel: 
    pressHints:
    - voice: 1
      text: "\u76D1\u63A7 23:00\u201323:30 \u88AB\u5220\u4E86\u2014\u2014\u4ED6\u4EE5\u4E3A\u6CA1\u4EBA\u77E5\u9053\u3002"
    - voice: 3
      text: "\u8BA9\u88AB\u4E70\u901A\u7684\u4FDD\u5B89\u5F00\u53E3\uFF0C\u4ED6\u7684\u201C\u8BC1\u660E\u201D\u5C31\u584C\u4E86\u3002"
    - voice: 2
      text: "\u4ED6\u5728\u8D4C\u4F60\u4EC0\u4E48\u90FD\u60F3\u4E0D\u8D77\u6765\u3002\u522B\u987A\u7740\u4ED6\u7684\u8BDD\u8D70\u3002"
    - voice: 4
      text: "\u4ED6\u5728\u6492\u8C0E\u3002\u4F60\u95FB\u5F97\u51FA\u6765\u3002"
    reactions:
    - clueId: clue_guard_bribed
      reply: "\u53EF\u4F60\u7684\u76D1\u63A7\uFF0C23:00 \u5230 23:30 \u662F\u7A7A\u7684\u3002\uFF08\u98CE\u8863\u7537\u5F00\u59CB\u614C\uFF09"
