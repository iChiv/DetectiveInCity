  - text: "\u2026\u2026\u5C31\u7B97\u76D1\u63A7\u6CA1\u4E86\uFF0C\u4E5F\u6CA1\u8BC1\u636E\u628A\u6211\u548C\u8FD9\u4E2A\u6848\u5B50\u8FDE\u8D77\u6765\u3002"
    phaseLabel: 
    pressHints:
    - voice: 1
      text: "\u6CA1\u6709\u76D1\u63A7\uFF0C\u8FD8\u6709\u522B\u7684\u2014\u2014\u80FD\u76F4\u63A5\u6307\u5411\u4ED6\u7684\u4E1C\u897F\u3002"
    - voice: 3
      text: "\u644A\u724C\u7684\u65F6\u5019\u5230\u4E86\uFF0C\u628A\u6700\u6709\u529B\u7684\u8BC1\u636E\u62CD\u51FA\u6765\u3002"
    - voice: 2
      text: "\u4ED6\u8FD8\u5728\u5634\u786C\u3002\u4E00\u53E5\u8BDD\u5C31\u80FD\u51FB\u788E\u4ED6\u3002"
    - voice: 4
      text: "\u4F60\u5F55\u4E0B\u4E86\u4ED6\u7684\u58F0\u97F3\u3002\u8BA9\u4ED6\u81EA\u5DF1\u542C\u542C\u3002"
