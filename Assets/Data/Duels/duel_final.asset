  duelId: final
  title: "\u6700\u7EC8\u5BF9\u51B3"
  opponentName: "\u98CE\u8863\u7537"
  openingLines:
  - "\u5475\u5475\uFF0C\u4F60\u7EC8\u4E8E\u60F3\u8D77\u6765\u4E86\uFF1F\u8FD8\u662F\u4F60\u73B0\u5728\u8FD8\u5728\u88C5\uFF1F"
  voicePopups:
  - voice: 1
    text: "\u4ED6\u5C31\u662F\u5728\u8FD9\u7B49\u4F60\u3002\u4ED6\u5E94\u8BE5\u5DF2\u7ECF\u51C6\u5907\u597D\u4E86\u3002"
  - voice: 2
    text: "\u611F\u89C9\u4ED6\u8BF4\u8BDD\u5E26\u70B9\u54ED\u8154\u3002\u96BE\u9053\u4ED6\u4E0D\u60F3\u8FD9\u6837\uFF1F"
  - voice: 3
    text: "\u4F60\u662F\u8B66\u5BDF\uFF0C\u76F4\u63A5\u902E\u6355\u4ED6\u3002"
  - voice: 4
    text: "\u5C31\u662F\u4F60\u6740\u7684\u4EBA\u3002\u4F60\u771F\u5FD8\u4E86\u5417\uFF1F"
  statements:
  - text: "\u4F60\u771F\u4EE5\u4E3A\u662F\u6211\u6740\u7684\uFF1F\u4F60\u4ECE\u5934\u5230\u5C3E\u90FD\u5728\u67E5\u6211\uFF0C\u53EF\u662F\u4F60\u53C8\u6709\u4EC0\u4E48\u8BC1\u636E\u5462\uFF1F"
    phaseLabel: "\u7B2C\u4E00\u9636\u6BB5\xB7\u4F60\u6000\u7591\u4ED6"
    pressHints:
    - voice: 1
      text: "22:45 \u5237\u4F60\u7684\u8B66\u5FBD\u8FDB\u516C\u5BD3\u7684\u4EBA\u2014\u2014\u4ED6\u81EA\u5DF1\u5FC3\u91CC\u6709\u6570\u3002"
    - voice: 2
      text: "\u4F60\u5199\u8FC7\u6000\u7591\u4ED6\u7684\u65E5\u8BB0\u3002\u90A3\u672C\u65E5\u8BB0\u8FD8\u5728\u3002"
    - voice: 3
      text: "\u4ED6\u5A01\u80C1\u522B\u4EBA\u7684\u5F55\u97F3\uFF0C\u5C31\u662F\u4F60\u7684\u8BC1\u636E\u3002"
    - voice: 4
      text: "\u6216\u8005\u2026\u2026\u4EC0\u4E48\u90FD\u522B\u95EE\uFF0C\u5148\u542C\u542C\u4E5E\u4E10\u770B\u89C1\u4E86\u4EC0\u4E48\u3002"
    reactions:
    - clueId: clue_recording_threat
