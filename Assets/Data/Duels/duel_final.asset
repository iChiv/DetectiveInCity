    pressHints:
    - voice: 1
      text: "\u4F60\u8138\u4E0A\u7684\u4F24\u662F\u600E\u4E48\u6765\u7684\uFF1F\u955C\u5B50\u4E0D\u4F1A\u6492\u8C0E\u3002"
    - voice: 2
      text: "\u4ED6\u5199\u8FC7\u4E00\u5C01\u4FE1\u7ED9\u4F60\u3002\u4E00\u5C01\u8B66\u544A\u3002"
    - voice: 3
      text: "\u522B\u8BA9\u4ED6\u7684\u8BDD\u5E26\u8282\u594F\u3002\u4F60\u624B\u91CC\u6709\u4ED6\u5BB3\u6015\u7684\u4E1C\u897F\u3002"
    - voice: 4
      text: "\u4F60\u5728\u5496\u5561\u5E97\u7684\u9910\u5DFE\u7EB8\u4E0A\u5199\u8FC7\u4EC0\u4E48\uFF0C\u5FD8\u4E86\u5417\uFF1F"
