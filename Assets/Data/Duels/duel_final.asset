    skipReply: "\u54FC\uFF0C\u6CA1\u8BDD\u8BF4\u4E86\u5427\u3002\uFF08\u98CE\u8863\u7537\u5C94\u5F00\u4E86\u8BDD\u9898\uFF09"
  - text: "\u800C\u4E14\u4F60\u6709\u6CA1\u6709\u60F3\u8FC7\u2014\u2014\u90A3\u5929\u665A\u4E0A\uFF0C\u53BB\u4ED6\u5BB6\u7684\u4EBA\u5176\u5B9E\u662F\u4F60\u3002"
